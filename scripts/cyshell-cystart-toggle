#!/usr/bin/env python3
import json
import os
import socket
import subprocess


CYSHELL = os.environ.get("CYSHELL_BIN", "/usr/local/bin/cyshell")


def pointer_output():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime_dir:
        return ""

    bridge_socket = os.path.join(runtime_dir, "cyshell-labwc.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.3)
            client.connect(bridge_socket)
            client.sendall(b'{"method":"pointer.output"}\n')
            response = bytearray()
            while b"\n" not in response:
                chunk = client.recv(1024)
                if not chunk:
                    break
                response.extend(chunk)
            message = json.loads(response.split(b"\n", 1)[0])
    except (OSError, ValueError):
        return ""

    if not isinstance(message, dict) or message.get("ok") is not True:
        return ""
    screen = message.get("screen")
    return screen.strip() if isinstance(screen, str) else ""


def main():
    screen = pointer_output()
    command = [CYSHELL, "ipc", "call", "cyStart", "toggle"]
    if screen:
        command[-1:] = ["toggleFor", screen]
    raise SystemExit(subprocess.run(command).returncode)


if __name__ == "__main__":
    main()
