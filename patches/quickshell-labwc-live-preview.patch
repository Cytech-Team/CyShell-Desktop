+class IccForeignToplevelHandle
+    : public QObject
+    , public QtWayland::ext_foreign_toplevel_handle_v1 {
+	Q_OBJECT;
+
+public:
+	explicit IccForeignToplevelHandle(::ext_foreign_toplevel_handle_v1* handle);
+	~IccForeignToplevelHandle() override;
+
+	[[nodiscard]] const QString& appId() const { return this->mAppId; }
+	[[nodiscard]] const QString& title() const { return this->mTitle; }
+	[[nodiscard]] const QString& identifier() const { return this->mIdentifier; }
+	[[nodiscard]] bool ready() const { return this->mReady; }
+
+signals:
+	void readyChanged();
+	void closed();
+
+private:
+	void ext_foreign_toplevel_handle_v1_closed() override;
+	void ext_foreign_toplevel_handle_v1_done() override;
+	void ext_foreign_toplevel_handle_v1_title(const QString& title) override;
+	void ext_foreign_toplevel_handle_v1_app_id(const QString& appId) override;
+	void ext_foreign_toplevel_handle_v1_identifier(const QString& identifier) override;
+
+	QString mAppId;
+	QString mTitle;
+	QString mIdentifier;
+	bool mReady = false;
+	bool mClosed = false;
+};
+
+class IccForeignToplevelList
+    : public QWaylandClientExtensionTemplate<IccForeignToplevelList>
+    , public QtWayland::ext_foreign_toplevel_list_v1 {
+	Q_OBJECT;
+
+public:
+	[[nodiscard]] IccForeignToplevelHandle*
+	findHandle(const QString& appId, const QString& title, int appOrdinal) const;
+
+	static IccForeignToplevelList* instance();
+
+private:
+	explicit IccForeignToplevelList();
+
+	void ext_foreign_toplevel_list_v1_toplevel(::ext_foreign_toplevel_handle_v1* toplevel) override;
+	void ext_foreign_toplevel_list_v1_finished() override;
+
+private slots:
+	void onHandleClosed();
+
+private:
+	QVector<IccForeignToplevelHandle*> mToplevels;
+};
