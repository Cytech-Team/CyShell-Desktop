+IccForeignToplevelHandle::IccForeignToplevelHandle(::ext_foreign_toplevel_handle_v1* handle) {
+	this->init(handle);
+}
+
+IccForeignToplevelHandle::~IccForeignToplevelHandle() {
+	if (this->object() && !this->mClosed) {
+		this->destroy();
+	}
+}
+
+void IccForeignToplevelHandle::ext_foreign_toplevel_handle_v1_closed() {
+	this->mClosed = true;
+	if (this->object()) this->destroy();
+	emit this->closed();
+	deleteLater();
+}
+
+void IccForeignToplevelHandle::ext_foreign_toplevel_handle_v1_done() {
+	auto wasReady = this->mReady;
+	this->mReady = true;
+	if (!wasReady) emit this->readyChanged();
+}
+
+void IccForeignToplevelHandle::ext_foreign_toplevel_handle_v1_title(const QString& title) {
+	this->mTitle = title;
+}
+
+void IccForeignToplevelHandle::ext_foreign_toplevel_handle_v1_app_id(const QString& appId) {
+	this->mAppId = appId;
+}
+
+void IccForeignToplevelHandle::ext_foreign_toplevel_handle_v1_identifier(
+    const QString& identifier
+) {
+	this->mIdentifier = identifier;
+}
+
+IccForeignToplevelList::IccForeignToplevelList(): QWaylandClientExtensionTemplate(1) {
+	this->initialize();
+}
+
+IccForeignToplevelList* IccForeignToplevelList::instance() {
+	static auto* instance = new IccForeignToplevelList();
+	return instance;
+}
+
+void IccForeignToplevelList::ext_foreign_toplevel_list_v1_toplevel(
+    ::ext_foreign_toplevel_handle_v1* toplevel
+) {
+	auto* handle = new IccForeignToplevelHandle(toplevel);
+	QObject::connect(handle, &IccForeignToplevelHandle::closed, this, &IccForeignToplevelList::onHandleClosed);
+	this->mToplevels.push_back(handle);
+}
+
+void IccForeignToplevelList::ext_foreign_toplevel_list_v1_finished() {
+	qCInfo(logIcc) << "Foreign toplevel list stopped by compositor.";
+}
+
+void IccForeignToplevelList::onHandleClosed() {
+	auto* handle = qobject_cast<IccForeignToplevelHandle*>(this->sender());
+	this->mToplevels.removeOne(handle);
+}
+
+IccForeignToplevelHandle* IccForeignToplevelList::findHandle(
+    const QString& appId,
+    const QString& title,
+    int appOrdinal
+) const {
+	QVector<IccForeignToplevelHandle*> ready;
+	QVector<IccForeignToplevelHandle*> exact;
+
+	for (auto* handle: this->mToplevels) {
+		if (!handle || !handle->ready() || handle->appId() != appId) continue;
+		ready.push_back(handle);
+		if (!title.isEmpty() && handle->title() == title) exact.push_back(handle);
+	}
+
+	// A unique title is the strongest mapping when several windows share an app id.
+	if (exact.size() == 1) return exact.first();
+
+	// Both zwlr-foreign-toplevel-management and ext-foreign-toplevel-list are emitted
+	// in compositor creation order on wlroots. Matching the Nth window for a given
+	// app id disambiguates identical-title windows without guessing from screen state.
+	if (appOrdinal >= 0 && appOrdinal < ready.size()) return ready.at(appOrdinal);
+
+	// A single window for an app id is unambiguous even if its title changed between
+	// the two protocol event streams.
+	if (ready.size() == 1) return ready.first();
+
+	return nullptr;
+}
+
+IccToplevelSourceManager::IccToplevelSourceManager(): QWaylandClientExtensionTemplate(1) {
+	this->initialize();
+	// Bind the list global eagerly so its creation order starts alongside the source manager.
+	IccForeignToplevelList::instance();
+}
+
+IccToplevelSourceManager* IccToplevelSourceManager::instance() {
+	static auto* instance = new IccToplevelSourceManager();
+	return instance;
+}
+
+ScreencopyContext* IccToplevelSourceManager::captureToplevel(
+    const QString& appId,
+    const QString& title,
+    int appOrdinal,
+    bool paintCursors
+) {
+	auto* list = IccForeignToplevelList::instance();
+	if (!list->isActive()) return nullptr;
+
+	auto* handle = list->findHandle(appId, title, appOrdinal);
+	if (!handle) {
+		// QWaylandClientExtension binds globals synchronously, but the compositor sends
+		// the initial ext-foreign-toplevel handles asynchronously. The first ScreencopyView
+		// can be created before those events are dispatched, so perform one roundtrip and
+		// retry the lookup. This happens only on a cold first capture.
+		auto* display = QtWaylandClient::QWaylandIntegration::instance()->display();
+		if (display && display->wl_display())
+			wl_display_roundtrip(display->wl_display());
+		handle = list->findHandle(appId, title, appOrdinal);
+	}
+
+	if (!handle) {
+		qCWarning(logIcc) << "No ext-foreign-toplevel capture source matched" << appId << title
+		                  << "ordinal" << appOrdinal;
+		return nullptr;
+	}
+
+	qCDebug(logIcc) << "Capturing ext-foreign-toplevel" << handle->identifier() << appId << title;
+	return IccManager::instance()->createSession(this->create_source(handle->object()), paintCursors);
+}
+
 } // namespace qs::wayland::screencopy::icc
