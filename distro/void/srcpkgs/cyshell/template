# Template file for 'cyshell'
#
# CyShell stable release
#
# NOTE: the binary is built with the `distro_binary` build tag (drops the
# in-app self-update command) and `withshell` (embeds the Quickshell UI; the
# shell no longer discovers an installed tree, so an unembedded binary has no UI).
# CI rewrites version/checksum from the selected release tag before building.
pkgname=cyshell
version=1.5.0
revision=2
build_style=go
build_wrksrc="core"
hostmakedepends="make tar"
go_import_path="github.com/Cytech-Team/CyShell-Desktop/core"
go_package="${go_import_path}/cmd/cyshell"
go_build_tags="distro_binary withshell"
go_ldflags="-X main.Version=${version}"
short_desc="CyShell — Labwc desktop shell for Wayland"
maintainer="AvengeMedia <AvengeMedia.US@gmail.com>"
license="MIT"
homepage="https://github.com/Cytech-Team/CyShell-Desktop"
changelog="https://github.com/Cytech-Team/CyShell-Desktop/releases"
distfiles="https://github.com/Cytech-Team/CyShell-Desktop/releases/download/v${version}/cyshell-source.tar.gz"
conflicts="dms dms-git cyshell-git"
provides="dms-${version}_${revision}"

checksum=14f2678d6a15223ba069d1b8c8a21a5564b735d190c231f62ed44fd8bf48677c

# Optional feature deps are listed in distro/void/README.md.
depends="quickshell accountsservice dgop matugen dbus elogind mesa-dri"

pre_build() {
	make sync-shell
}

post_install() {
	# Desktop entry + icon
	vinstall "${wrksrc}/assets/cyshell-open.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/com.cytechteam.cyshell.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/com.cytechteam.cyshell.notepad.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/com.cytechteam.cyshell.png" 644 usr/share/icons/hicolor/512x512/apps

	# Shell completions (generated by the built binary; skip when cross-building)
	vmkdir usr/share/bash-completion/completions
	vmkdir usr/share/zsh/site-functions
	vmkdir usr/share/fish/vendor_completions.d
	if [ -z "$CROSS_BUILD" ]; then
		"${DESTDIR}/usr/bin/cyshell" completion bash > "${DESTDIR}/usr/share/bash-completion/completions/cyshell"
		"${DESTDIR}/usr/bin/cyshell" completion zsh  > "${DESTDIR}/usr/share/zsh/site-functions/_cyshell"
		"${DESTDIR}/usr/bin/cyshell" completion fish > "${DESTDIR}/usr/share/fish/vendor_completions.d/cyshell.fish"
	fi

	vlicense "${wrksrc}/LICENSE"
}
