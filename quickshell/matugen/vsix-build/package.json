{
  "name": "cyshell-theme",
  "displayName": "CyShell Dynamic Theme",
  "description": "Dynamic theme using matugen and terminal colors, auto-updated by CyShell",
  "publisher": "Cytech-Team",
  "version": "0.0.3",
  "icon": "cyshell.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "cyshell",
    "cytech",
    "material",
    "matugen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cytech-Team/CyShell-Desktop"
  },
  "contributes": {
    "themes": [
      {
        "label": "Dynamic Base16 CyShell",
        "uiTheme": "vs-dark",
        "path": "./themes/cyshell-default.json",
        "_watch": true
      },
      {
        "label": "Dynamic Base16 CyShell (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/cyshell-dark.json",
        "_watch": true
      },
      {
        "label": "Dynamic Base16 CyShell (Light)",
        "uiTheme": "vs",
        "path": "./themes/cyshell-light.json",
        "_watch": true
      }
    ]
  }
}
