[Unit]
Description=CyShell Core Runtime
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
Wants=cyshell-runtime-ui.service cyshell-shell-ui.service cyshell-settings-surface.service cyshell-panel.service cyshell-desktop.service cyshell-osd.service cyshell-ui-surfaces.service

[Service]
Type=simple
ExecStart=/usr/bin/cyshell core
LimitNOFILE=16384:infinity
Restart=on-failure
RestartSec=1.23
TimeoutStartSec=30s
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
