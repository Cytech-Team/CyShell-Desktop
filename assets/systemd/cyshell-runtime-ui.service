[Unit]
Description=CyShell QML Runtime Services
PartOf=graphical-session.target
After=cyshell.service graphical-session.target
Wants=cyshell.service
Requisite=graphical-session.target

[Service]
Type=simple
Environment=CYSHELL_GLOBAL_OWNER=1
ExecStart=/usr/bin/cyshell surface runtime
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
