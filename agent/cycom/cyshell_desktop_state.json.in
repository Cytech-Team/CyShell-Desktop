{
  "name": "cyshell_desktop_state",
  "title": "CyShell semantic desktop state",
  "description": "Read authoritative non-sensitive state from the active CyShell desktop, including CyShell Built-in native window readiness. Legacy Any App doctor windowing fields are transitional helper diagnostics and are not authoritative for CyShell Built-in readiness.",
  "command": "@CYSHELL_AGENT_BRIDGE@",
  "args": ["desktop-state"],
  "timeout_seconds": 10,
  "max_output_bytes": 8388608,
  "input_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  }
}
